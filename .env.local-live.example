# Local-only real WeKnora model profiles (OpenSpec 023 R1.1).
# Copy to .env.local-live, fill credentials, then run: chmod 600 .env.local-live
# This example is intentionally credential-free. Never commit the populated file.

LOCAL_LIVE_WEKNORA_CHAT_BASE_URL=https://api.siliconflow.cn/v1
LOCAL_LIVE_WEKNORA_CHAT_API_KEY=
LOCAL_LIVE_WEKNORA_CHAT_MODEL=Pro/MiniMaxAI/MiniMax-M2.5

LOCAL_LIVE_WEKNORA_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
LOCAL_LIVE_WEKNORA_EMBEDDING_API_KEY=
LOCAL_LIVE_WEKNORA_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B

LOCAL_LIVE_WEKNORA_RERANK_BASE_URL=https://api.siliconflow.cn/v1
LOCAL_LIVE_WEKNORA_RERANK_API_KEY=
LOCAL_LIVE_WEKNORA_RERANK_MODEL=Qwen/Qwen3-VL-Reranker-8B

# Harness extraction is independent from the three WeKnora platform roles.
HARNESS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
HARNESS_LLM_API_KEY=
HARNESS_LLM_MODEL_WEAK=deepseek-v4-flash
