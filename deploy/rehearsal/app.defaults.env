# I3a fresh-install settings for the App (non-secret). Secrets are generated by rehearsal.sh into
# $REHEARSAL_HOME and never committed. Registration stays open only until the first user exists
# (`rehearsal.sh seed` turns it off through spaces.env when it restarts the App).
AUTO_MIGRATE=true
AUTO_RECOVER_DIRTY=false
DB_DRIVER=postgres
DB_NAME=weknora
DB_USER=weknora
DB_PORT=5432
REDIS_DB=0
RETRIEVE_DRIVER=postgres
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
DOCUMENT_STORAGE_MIN_FREE_BYTES=2147483648
MAX_FILE_SIZE_MB=128
DOCREADER_TRANSPORT=grpc
ENTERPRISE_CONTRACTS_DIR=/app/contracts
GIN_MODE=release
GOMEMLIMIT=1400MiB
PORT=8080
BATCH_EMBED_SIZE=20
WEKNORA_HOUSEKEEPING_ENABLED=false
WEKNORA_TENANT_ENABLE_CROSS_TENANT_ACCESS=false
KNOWLEDGE_REVISION_SOURCE_BACKFILL_ENABLED=false
DISABLE_REGISTRATION=false
# Model hosts the SSRF check must accept although they resolve into a reserved range: a desktop proxy
# with fake-IP DNS answers 198.18.0.0/15 (seen on the rehearsal Mac, as on live). On a host whose DNS
# returns real addresses this line is unnecessary; never list internal addresses here.
SSRF_WHITELIST_EXTRA=dashscope.aliyuncs.com
