{% extends "base.html.j2" %}
{% block title %}冲突与变更{% endblock %}
{% block body %}
<h1>冲突与变更</h1>
<table>
  <thead><tr><th>ChangeSet</th><th>来源</th><th>状态</th><th>发起</th><th>动作计数</th></tr></thead>
  <tbody>
  {% for cs in sets %}
    <tr>
      <td><a href="/spaces/{{ space_id }}/changes/{{ cs.change_set_id }}">{{ cs.change_set_id }}</a>
          <span class="evidence">{{ cs.created_at }}</span></td>
      <td>{{ cs.source_kind }}</td>
      <td>{{ cs.status }}</td>
      <td>{{ cs.created_by }}</td>
      <td>
        {% for action, n in cs.action_counts.items() %}
          <span class="badge action-{{ action }}">{{ action }}×{{ n }}</span>
        {% endfor %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endblock %}
