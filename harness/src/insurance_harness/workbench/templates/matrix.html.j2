{% extends "base.html.j2" %}
{% block title %}完整度矩阵{% endblock %}
{% block body %}
<h1>完整度矩阵</h1>
<p class="evidence">schema {{ matrix.schema_version }} · 产品×schema 全字段底图（未收录=unknown）</p>
<form method="get" action="/spaces/{{ space_id }}/matrix">
  险种 <select name="category">
    <option value="">全部</option>
    {% for c in matrix.categories %}
      <option value="{{ c }}" {% if matrix.category == c %}selected{% endif %}>{{ c }}</option>
    {% endfor %}
  </select>
  <button>筛选</button>
</form>
<p><a href="/spaces/{{ space_id }}/matrix/export?fmt=csv{% if matrix.category %}&category={{ matrix.category }}{% endif %}">导出缺口 CSV</a> ·
   <a href="/spaces/{{ space_id }}/matrix/export?fmt=jsonl{% if matrix.category %}&category={{ matrix.category }}{% endif %}">导出缺口 JSONL</a>
   <span class="evidence">（缺口=unknown/pending_review/conflict_open；present/absent 不入缺口清单）</span></p>
<table>
  <thead><tr><th>产品</th><th>版本</th><th>险种</th><th>字段格</th></tr></thead>
  <tbody>
  {% for row in matrix.rows %}
    <tr>
      <td>{{ row.product_code }} {{ row.product_name }}</td>
      <td>{{ row.version_label }}</td>
      <td>{{ row.category }}{% if row.schema_missing %}<div class="notice">险种不在 schema 注册表，仅显示观测数据</div>{% endif %}</td>
      <td>
        {% for field, cell in row.cells.items() %}
          <a class="cell state-{{ cell.state }}"
             title="{{ cell.field_name or field }}"
             href="/spaces/{{ space_id }}/matrix/{{ row.version_id }}/{{ field }}">
            {{ field }}:{{ cell.state }}
          </a>
        {% endfor %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endblock %}
