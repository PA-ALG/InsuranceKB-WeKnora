# ===== InsuranceKB Harness 配置模板 =====
# 复制为 harness/.env 并填入真实值（.env 已被 gitignore，勿提交密钥）。
# 权威定义见 src/insurance_harness/config.py（HarnessSettings，env 前缀 HARNESS_）。

# --- WeKnora 平台（14 号文档 §2 初始化后获得）---
HARNESS_WEKNORA_BASE_URL=http://localhost:8080/api/v1
HARNESS_WEKNORA_API_KEY=sk-xxxx                # Tenant API Key，能力域 retrieve+ingest
# 双知识库 ID（KB-RAW 原始资料库 / KB-WIKI 寿险知识 Wiki）
# （KB ID 目前按调用传参，不在 Settings 内；14 号文档初始化后记录于团队配置）

# --- 模型网关（百炼 DashScope OpenAI 兼容端点）---
HARNESS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
HARNESS_LLM_API_KEY=sk-xxxx
HARNESS_LLM_MODEL_WEAK=deepseek-v4-flash        # 抽取主力弱模型（备选 MiniMax/MiniMax-M2.5）
# 注意：推理型模型返回 reasoning_content——客户端已处理（只取 content、max_tokens>=4096、截断重试）

# --- 裁决模式 ---
HARNESS_JUDGE_MODE=claude-session               # claude-session=裁决队列由 Claude 会话批处理 | gateway=直连兜底模型
HARNESS_LLM_MODEL_JUDGE_FALLBACK=deepseek-v4-pro

# --- Harness 数据库（docker-compose.harness.yml 默认值；不配则测试用 sqlite）---
# HARNESS_DB_URL=postgresql+psycopg://harness:harness@localhost:5442/harness

# --- 金标子系统（Claude 会话模式下可不配；接 API 时用）---
# HARNESS_GOLDENSET_MODEL=
# HARNESS_GOLDENSET_API_BASE=
# HARNESS_GOLDENSET_API_KEY=

# --- 可观测（可选，与 WeKnora 共用 Langfuse 实例；不配则静默降级）---
# HARNESS_LANGFUSE_PUBLIC_KEY=
# HARNESS_LANGFUSE_SECRET_KEY=
# HARNESS_LANGFUSE_HOST=

# --- 轮询/重试（有默认值，一般不用改）---
# HARNESS_POLL_INTERVAL_S=2
# HARNESS_POLL_TIMEOUT_S=600
# HARNESS_RETRY_MAX_ATTEMPTS=3
