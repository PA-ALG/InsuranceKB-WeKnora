{
  "$defs": {
    "ProfileField": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "field_key": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Field Key",
          "type": "string"
        },
        "schema_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Category"
        },
        "short_title": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Short Title",
          "type": "string"
        }
      },
      "required": [
        "field_key",
        "short_title"
      ],
      "title": "ProfileField",
      "type": "object"
    },
    "ProfileSection": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Display Name",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/ProfileField"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "section_key": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Section Key",
          "type": "string"
        }
      },
      "required": [
        "section_key",
        "display_name",
        "fields"
      ],
      "title": "ProfileSection",
      "type": "object"
    }
  },
  "$id": "https://pa-alg.github.io/InsuranceKB-WeKnora/contracts/presentation_profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A pack's display groups and field order, published with the release it renders.\n\nReaders show an entity with the first profile whose entity_types name its type; otherwise with\na profile without entity_types whose classification_labels meet the entity's (SK-3 §1), so each\nfield and section appears once and the labels or types say which entities it serves.",
  "properties": {
    "classification_labels": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Classification Labels",
      "type": "array"
    },
    "display_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Display Name"
    },
    "entity_types": {
      "anyOf": [
        {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entity Types"
    },
    "knowledge_class": {
      "anyOf": [
        {
          "const": "method",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Knowledge Class"
    },
    "notices": {
      "patternProperties": {
        "\\S": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        }
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Notices",
      "type": "object"
    },
    "profile_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Profile Id",
      "type": "string"
    },
    "profile_sha256": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "title": "Profile Sha256",
      "type": "string"
    },
    "profile_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Profile Version",
      "type": "string"
    },
    "reading_note": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reading Note"
    },
    "schema_pack_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Schema Pack Id",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/ProfileSection"
      },
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "profile_sha256",
    "schema_pack_id",
    "sections"
  ],
  "title": "PresentationProfile",
  "type": "object"
}
